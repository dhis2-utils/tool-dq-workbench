[Unit]
Description=Run DQ Workbench once a day

[Timer]
# Local time on the DHIS2 server. Pick a slot before the nightly analytics table
# generation so dashboards pick up the new values, and clear of backups.
OnCalendar=*-*-* 01:30:00 Asia/Yangon
# Run a missed slot (e.g. container was down) at the next boot
Persistent=true
Unit=dq-workbench.service

[Install]
WantedBy=timers.target
